# ==============================================================================
# WHITEBOARD VIDEO - CONFIGURATION TEMPLATE
# Sao chép file này thành .env rồi điền giá trị: cp .env.example .env
# File .env đã nằm trong .gitignore, KHÔNG commit key thật lên Git.
# ==============================================================================

# ==============================================================================
# Google AI Studio (Gemini TTS API) - Động cơ Voice-Over duy nhất của dự án
# Đăng ký lấy API Key tại: https://aistudio.google.com/
# Có thể điền 1 hoặc nhiều API Key ngăn cách bởi dấu phẩy để tự động xoay tua.
# ==============================================================================
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_API_KEYS=your_first_api_key_here,your_second_api_key_here

# Mô hình Gemini TTS: gemini-3.8-flash-tts (Khuyên dùng)
TTS_MODEL_MODE=gemini-3.8-flash-tts
GEMINI_MODEL=gemini-3.8-flash-tts

# Custom Voice ID độc quyền của kênh (sinh tự động qua: cd tts-voiceover-engine && npm run init-voice)
CUSTOM_VOICE_ID=voice_xnxd3uit2744

# Giọng Prebuilt dự phòng (nếu không dùng Custom Voice ID):
# Lựa chọn: Achird (Nam trẻ thân thiện), Charon (Nam trầm ấm), Puck (Nam hoạt bát),
#           Aoede (Nữ truyền cảm), Erinome (Nữ rõ ràng sư phạm), Kore (Nữ tự tin)
PREBUILT_FALLBACK_VOICE=Achird
