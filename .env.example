# Sao chép file này thành .env rồi điền giá trị: cp .env.example .env
# .env đã nằm trong .gitignore, KHÔNG commit key thật.

# ===================================================
# Giọng đọc (Text-to-Speech)
# ===================================================
# Engine: gemini (Google AI Studio - chất lượng cao nhất), edge (miễn phí), hoặc vbee
TTS_PROVIDER=gemini

# Giọng mặc định:
# - Gemini (30 giọng):
#     + Nam uy tín, chiến lược: Charon (mặc định), Rasalgethi, Alnilam
#     + Nam tự nhiên, thân thiện: Puck, Achird, Fenrir
#     + Nữ rõ ràng, học thuật: Kore, Erinome, Zephyr
#     + Nữ ấm áp, truyền cảm: Sulafat, Vindemiatrix, Aoede
# - Edge: vi-VN-NamMinhNeural (nam), vi-VN-HoaiMyNeural (nữ)
# - Vbee: dán nguyên mã giọng (voice_code) copy từ giao diện Vbee
TTS_VOICE=Charon

# Tốc độ đọc: 1.0 = bình thường, 1.05 = nhanh hơn 5% (khoảng 0.1 - 1.9)
TTS_SPEED=1.0

# ===================================================
# Google AI Studio (Gemini TTS API)
# Đăng ký miễn phí tại: https://aistudio.google.com/
# Có thể điền 1 hoặc nhiều API key (từ các Gmail khác nhau) cách nhau bởi dấu phẩy
# để tự động xoay tua khi gặp giới hạn quota (429).
# ===================================================
GEMINI_API_KEYS=your_first_gemini_api_key_here,your_second_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ===================================================
# Vbee TTS API (chỉ cần khi TTS_PROVIDER=vbee) — đăng ký tại https://vbee.vn
# ===================================================
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
